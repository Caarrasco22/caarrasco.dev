---
const { project, index } = Astro.props;
---

<article class:list={["project-card", index < 2 && "project-card--featured"]}>
  <span class="project-card__index">{String(index + 1).padStart(2, "0")}</span>
  <div class="project-card__top">
    <span class="badge"><i></i>{project.status}</span>
    <h3>{project.title}</h3>
  </div>

  <p>{project.description}</p>

  <ul class="tag-list" aria-label={`Tecnologías y áreas de ${project.title}`}>
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {
    project.links.length > 0 && (
      <div class="project-links">
        {project.links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label} <span>↗</span>
          </a>
        ))}
      </div>
    )
  }
</article>
