---
import { profile } from "../data/portfolio.js";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__status"><span></span> Disponible para nuevos proyectos</div>
  <div class="hero__layout">
    <div class="hero__main">
      <p class="hero__kicker">Técnico autodidacta · Maker · Builder</p>
      <h1 id="hero-title">Ideas que<br /><em>sí funcionan.</em></h1>
    </div>
    <div class="hero__aside">
      <p>{profile.summary}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#proyectos">Ver proyectos <span>↓</span></a>
        <a class="text-link" href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
  </div>
  <div class="hero__meta">
    <span>La Línea · Cádiz</span><span>Hardware + Software</span><span>Scroll to explore ↓</span>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <span>BUILD</span><i>✦</i><span>BREAK</span><i>✦</i><span>LEARN</span><i>✦</i><span>IMPROVE</span><i>✦</i>
    <span>BUILD</span><i>✦</i><span>BREAK</span><i>✦</i><span>LEARN</span><i>✦</i><span>IMPROVE</span><i>✦</i>
  </div>
</div>
