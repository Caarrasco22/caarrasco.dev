---
import '../styles/global.css';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CaarrascoVisuals | Edición de vídeo musical</title>
  <meta name="description" content="Portfolio de edición de vídeo, ritmo, color y narrativa visual.">
  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; }
  </style>
</head>
<body style="background:#050505;margin:0;padding:0;height:100%;">
  <iframe
    src="/portfolio/index.html"
    style="width:100%;height:100%;border:none;position:fixed;top:0;left:0;"
    title="CaarrascoVisuals Portfolio"
  ></iframe>
</body>
</html>