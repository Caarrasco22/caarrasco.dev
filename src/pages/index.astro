---
import "../styles/experience.css";
import ScrollPortfolio from "../components/ScrollPortfolio.astro";

const pageTitle = "Pablo Carrasco | Tecnología + Cultura visual";
const pageDescription =
  "Proyectos de Pablo Carrasco: software, homelab, automatización y portfolio audiovisual. Herramientas útiles e historias con carácter, desde Cádiz.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <ScrollPortfolio />
  </body>
</html>
